{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(alembic:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(uvicorn:*)",
      "Bash(celery:*)",
      "Bash(cd:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(set:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(deactivate)",
      "Bash(psql:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase origin/main)",
      "Bash(git checkout -b:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(scripts/wt-env.sh:*)",
      "Bash(scripts/link-arch-refs.sh:*)",
      "Edit",
      "Write",
      "Read"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pnpm add:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git merge:*)",
      "Bash(rm -rf:*)",
      "Edit(docs/architecture.md)",
      "Edit(docs/api-contract.md)",
      "Edit(.claude/skills/amee-arch-check/references/architecture.md)",
      "Edit(.claude/skills/amee-arch-check/references/api-contract.md)",
      "Edit(frontend/src/api/types.gen.ts)",
      "Read(.env.secrets)"
    ]
  },
  "worktree": { "baseRef": "fresh" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/guard-protected-paths.sh" }
        ]
      }
    ]
  }
}